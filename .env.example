# The application works in synthetic demo mode without backend credentials.

# Dedicated MedAtlas Supabase project — deferred. Do not point these variables
# at Achegue-se, OrdaX or another product database.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Anatomy assets are vendored under public/atlas-assets by default.
# Optional only for controlled development/testing overrides.
# VITE_ATLAS_ASSET_BASE=


# Detailed organ GLBs are lazy-loaded from the pinned permitted upstream
# checkpoint by default. Override only with a controlled equivalent asset
# origin containing the same model filenames.
# VITE_ORGAN_DETAIL_ASSET_BASE=
